{
  "name": "scsc-association-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "powershell -ExecutionPolicy Bypass -Command \"$env:NEXT_DIST_DIR='.next-dev'; .\\node_modules\\node\\bin\\node.exe .\\node_modules\\next\\dist\\bin\\next dev\"",
    "build": "next build",
    "build:local": "powershell -ExecutionPolicy Bypass -Command \"$env:NEXT_DIST_DIR='.next-prod'; .\\node_modules\\node\\bin\\node.exe .\\node_modules\\next\\dist\\bin\\next build\"",
    "start": "next start",
    "start:local": "powershell -ExecutionPolicy Bypass -Command \"$env:NEXT_DIST_DIR='.next-prod'; .\\node_modules\\node\\bin\\node.exe .\\node_modules\\next\\dist\\bin\\next start\"",
    "lint": "next lint",
    "lint:local": ".\\node_modules\\node\\bin\\node.exe .\\node_modules\\next\\dist\\bin\\next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:local": ".\\node_modules\\node\\bin\\node.exe .\\node_modules\\typescript\\bin\\tsc --noEmit --incremental false",
    "setup:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup-local.ps1",
    "run:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-local.ps1",
    "firebase:emulators": ".\\node_modules\\node\\bin\\node.exe .\\node_modules\\firebase-tools\\lib\\bin\\firebase.js emulators:start",
    "firebase:deploy:rules": ".\\node_modules\\node\\bin\\node.exe .\\node_modules\\firebase-tools\\lib\\bin\\firebase.js deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:admin:check": "node scripts/check-firebase-admin-env.mjs",
    "firebase:prod:check": "node scripts/check-production-firebase.mjs",
    "firebase:seed": "node --env-file=.env.local scripts/seed-firestore.mjs",
    "functions:build": "npm --prefix functions run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test -g @smoke",
    "test:e2e:redirect": "playwright test -g @redirect",
    "test:unit": "jest --config jest.config.js",
    "test:unit:watch": "jest --config jest.config.js --watch",
    "test:integration": "jest --config jest.config.js --runInBand tests/integration",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^10.12.5",
    "firebase-admin": "^12.6.0",
    "framer-motion": "^11.3.19",
    "jose": "^5.9.3",
    "lucide-react": "^0.454.0",
    "next": "^14.2.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.3",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.14.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "firebase-tools": "^15.15.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "node": "^22.14.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2"
  }
}
