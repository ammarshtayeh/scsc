rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isCompany() {
      return isSignedIn() && role() == "company";
    }

    function isAdminOrModerator() {
      return isSignedIn() && (role() == "admin" || role() == "moderator");
    }

    match /images/events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /images/archived-events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /images/products/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdminOrModerator() || isCompany();
    }

    match /images/articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /images/board/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /images/home/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /videos/home/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    match /images/members/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdminOrModerator());
    }

    match /documents/cvs/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
          || request.resource.contentType.matches('application/rtf')
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType.matches('application/vnd.oasis.opendocument.text')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/octet-stream')
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
